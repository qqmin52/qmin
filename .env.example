# Qmin 配置示例：复制为 .env 后填写，或直接执行 qmin init
# 获取 APP_ID / APP_SECRET：https://q.qq.com → 你的机器人 → 开发设置
# 注意：本框架仅调用 QQ 开放平台官方 Bot API，不是腾讯官方产品

# QQ 开放平台机器人 AppID（必填，例如 100000001）
APP_ID=你的AppID
# QQ 开放平台机器人 AppSecret（必填，请勿提交到仓库）
APP_SECRET=你的AppSecret
# 管理面板与写接口令牌（留空时由 qmin init 自动生成；首次在面板完成配置时也会生成）
ADMIN_TOKEN=
# 管理接口监听地址（默认 127.0.0.1，仅本机可访问）
HOST=127.0.0.1
# 管理接口监听端口（默认 8000）
PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO
# SQLite 数据库文件路径（默认 qmin.db，用于日志持久化，重启不丢）
DB_PATH=qmin.db
# 日志表最多保留多少行（默认 50000，超出后自动裁剪最旧记录）
LOG_MAX_ROWS=50000
# SDK 日志导流级别：off 只导 WARNING 及以上，all 连 INFO 一起导（默认 off）
LOG_SDK=off
# 入站消息日志是否记录正文（默认 true；false 时只记录会话 ID，保护隐私）
LOG_MESSAGE_CONTENT=true
