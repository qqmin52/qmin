# Qmin 配置示例：复制为 .env 后填写，或在项目根目录执行 qmin init 自动生成

# QQ 开放平台 → 机器人 → 开发设置
APP_ID=你的AppID
APP_SECRET=你的AppSecret

# 管理接口写操作令牌；留空时执行 qmin init / qmin run 会自动生成
ADMIN_TOKEN=

# 管理接口监听地址与端口（默认仅本机访问）
HOST=127.0.0.1
PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# SQLite 数据库文件路径
DB_PATH=qmin.db
